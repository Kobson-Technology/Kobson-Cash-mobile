{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "echo \"Aucune dependance npm ici : Flutter est installe par le script de construction.\"",
  "buildCommand": "bash scripts/vercel-build.sh",
  "outputDirectory": "build/web",
  "rewrites": [
    {
      "source": "/((?!flutter_service_worker\\.js|manifest\\.json|icons/|assets/|favicon\\.png).*)",
      "destination": "/index.html"
    }
  ]
}